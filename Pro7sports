<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Pro7 Sportswear</title>

<style>
body{
    margin:0;
    font-family:Arial;
    background:#0a0a0a;
    color:white;
}

/* HEADER */
header{
    background:linear-gradient(90deg,#000,#111,#000);
    padding:20px;
    text-align:center;
    font-size:30px;
    font-weight:bold;
    color:#00ffcc;
    letter-spacing:2px;
}

/* HERO */
.hero{
    text-align:center;
    padding:60px 20px;
}

.hero h1{
    font-size:40px;
    text-shadow:0 0 10px #00ffcc;
}

.hero p{
    color:#aaa;
}

/* 3D BUTTON */
.btn{
    background:#00ffcc;
    color:black;
    padding:12px 25px;
    border:none;
    margin-top:20px;
    font-weight:bold;
    cursor:pointer;
    transition:0.3s;
    box-shadow:0 0 20px #00ffcc;
}
.btn:hover{
    transform:scale(1.1);
}

/* CATEGORY SECTION */
.section{
    padding:50px 20px;
    text-align:center;
}

.section h2{
    font-size:30px;
    margin-bottom:30px;
    color:#00ffcc;
}

/* 3D CARDS */
.grid{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:20px;
}

.card{
    width:220px;
    background:#111;
    padding:20px;
    border-radius:15px;
    box-shadow:0 10px 25px rgba(0,255,204,0.2);
    transition:0.4s;
    transform-style:preserve-3d;
}

.card:hover{
    transform:rotateY(10deg) rotateX(10deg) scale(1.05);
    box-shadow:0 0 30px #00ffcc;
}

.card h3{
    color:#00ffcc;
}

/* FOOTER */
footer{
    text-align:center;
    padding:20px;
    background:#000;
    margin-top:40px;
    color:#666;
}
</style>

</head>

<body>

<header>
PRO7 SPORTSWEAR
</header>

<div class="hero">
    <h1>ALL SPORTS WEAR IN ONE PLACE</h1>
    <p>American Football | Cricket | Gym | Soccer | Custom Kits</p>
    <button class="btn">SHOP NOW</button>
</div>

<div class="section">
    <h2>OUR CATEGORIES</h2>

    <div class="grid">

        <div class="card">
            <h3>American Football</h3>
            <p>Custom jerseys, pants & pads</p>
        </div>

        <div class="card">
            <h3>Cricket Kits</h3>
            <p>Professional team uniforms</p>
        </div>

        <div class="card">
            <h3>Gym Wear</h3>
            <p>Dry fit & training outfits</p>
        </div>

        <div class="card">
            <h3>Soccer Kits</h3>
            <p>Club & academy uniforms</p>
        </div>

        <div class="card">
            <h3>Custom Design</h3>
            <p>Your logo, your style</p>
        </div>

    </div>
</div>

<footer>
© 2026 Pro7 Sportswear | All Rights Reserved
</footer>

</body>
</html>
